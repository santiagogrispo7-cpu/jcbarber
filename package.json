{
  "name": "jc-barber",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/portable.mjs",
    "build:booking": "vite build",
    "preview:booking": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "preview": "vite preview --host 127.0.0.1",
    "images": "node scripts/optimize-images.mjs",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "test:booking": "playwright test --config=playwright.booking.config.js",
    "check": "npm run test:unit && npm run build && npm run test:e2e",
    "audit:performance": "node scripts/audit.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "lighthouse": "13.5.0",
    "prettier": "3.6.2",
    "sharp": "0.35.5",
    "vite": "8.3.4"
  }
}
